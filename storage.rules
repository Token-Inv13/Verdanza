rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function adminBinding(data) {
      return data.isActive == true
        && request.auth.token.get("email", null) is string
        && request.auth.token.email != ""
        && data.get("email", null) is string
        && data.email == request.auth.token.email
        && (data.get("uid", null) == null || data.get("uid", null) == request.auth.uid);
    }

    function adminByUid() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid))
        && adminBinding(firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data);
    }

    function adminByEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && !firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid))
        && request.auth.token.get("email", null) is string
        && request.auth.token.email != ""
        && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.token.email))
        && adminBinding(firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.token.email)).data);
    }

    function isAdmin() {
      return adminByUid() || adminByEmail();
    }

    function isAllowedProductImage() {
      return request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType in ["image/jpeg", "image/png", "image/webp"];
    }

    match /products/{productId}/{imageId} {
      allow read: if true;
      allow create, update: if isAdmin() && isAllowedProductImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
