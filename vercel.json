{
  "installCommand": "npm install && dnf install -y nspr nss && npx playwright install chromium",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev -- --host 127.0.0.1",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.verdanza.fr"
        }
      ],
      "destination": "https://verdanza.fr/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.verdanza.fr"
        }
      ],
      "destination": "https://verdanza.fr/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "verdanza-cbd.fr"
        }
      ],
      "destination": "https://verdanza.fr/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "verdanza-cbd.fr"
        }
      ],
      "destination": "https://verdanza.fr/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.verdanza-cbd.fr"
        }
      ],
      "destination": "https://verdanza.fr/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.verdanza-cbd.fr"
        }
      ],
      "destination": "https://verdanza.fr/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "verdanza-opal.vercel.app"
        }
      ],
      "destination": "https://verdanza.fr/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "verdanza-opal.vercel.app"
        }
      ],
      "destination": "https://verdanza.fr/:path*",
      "permanent": true
    },
    {
      "source": "/produits/plutonium-cbd-hydroponique",
      "destination": "/fleurs-cbd",
      "permanent": true
    },
    {
      "source": "/livraison-express-aix",
      "destination": "/livraison-locale",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/contests",
      "destination": "/api/contest-api?__verdanzaRoute=public"
    },
    {
      "source": "/api/admin-contests",
      "destination": "/api/contest-api?__verdanzaRoute=admin"
    },
    {
      "source": "/api/contest-prize",
      "destination": "/api/contest-api?__verdanzaRoute=prize"
    },
    {
      "source": "/api/retry-order-purchase-analytics",
      "destination": "/api/order-analytics?__verdanzaRoute=retry-purchase"
    },
    {
      "source": "/api/revoke-order-analytics",
      "destination": "/api/order-analytics?__verdanzaRoute=revoke"
    },
    {
      "source": "/api/admin-payment-links",
      "destination": "/api/payment-links?__verdanzaRoute=list"
    },
    {
      "source": "/api/send-payment-link",
      "destination": "/api/payment-links?__verdanzaRoute=send"
    },
    {
      "source": "/api/public-promo-banners",
      "destination": "/api/quote-order?publicPromoBanners=1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/Fiche produit/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
