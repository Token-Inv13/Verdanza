{
  "installCommand": "npm install && dnf install -y nspr nss && npx playwright install chromium",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev -- --host 127.0.0.1",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/produits/plutonium-cbd-hydroponique",
      "destination": "/fleurs-cbd",
      "permanent": true
    },
    {
      "source": "/livraison-express-aix",
      "destination": "/livraison-locale",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/public-promo-banners",
      "destination": "/api/quote-order?publicPromoBanners=1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/Fiche produit/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
