{
  "name": "verdanza-cbd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && tsc -b && vite build && npm run prerender",
    "lint": "eslint .",
    "audit:seo": "node --import tsx scripts/seoAudit.ts",
    "audit:prerender": "node --import tsx scripts/auditPrerender.ts",
    "audit:runtime": "node --import tsx scripts/auditRuntime.ts",
    "audit:structured-data": "node --import tsx scripts/auditStructuredData.ts",
    "audit:indexnow": "node --import tsx scripts/auditIndexNow.ts",
    "audit:seo-landing-pages": "node --import tsx scripts/auditSeoLandingPages.ts",
    "audit:performance": "node --import tsx scripts/auditPerformance.ts",
    "audit:images": "node --import tsx scripts/auditImages.ts",
    "audit:blog": "node --import tsx scripts/auditBlog.ts",
    "audit:analytics": "node --import tsx scripts/auditAnalytics.ts",
    "audit:analytics-purchase": "node --import tsx scripts/auditServerPurchaseAnalytics.ts",
    "analyze:bundle": "node --import tsx scripts/analyzeBundle.ts",
    "images:generate": "node --import tsx scripts/generateImages.ts && node --import tsx scripts/generateFavicons.ts",
    "audit:seo-hosts": "node --import tsx scripts/auditSeoHosts.ts",
    "indexnow": "node --import tsx scripts/submitIndexNow.ts",
    "indexnow:verify": "node --import tsx scripts/verifyIndexNow.ts",
    "test:indexnow": "node --import tsx scripts/testIndexNow.ts",
    "test:catalog": "node --import tsx scripts/testProductAvailability.ts",
    "test:checkout-payment-options": "node --import tsx scripts/testCheckoutPaymentOptions.ts",
    "test:postal-delivery": "node --import tsx scripts/testPostalDelivery.ts",
    "test:address-delivery": "node --import tsx scripts/testAddressDelivery.ts",
    "test:fixed-price-formats": "node --import tsx scripts/testFixedPriceFormats.ts",
    "test:fixed-price-migration": "node --import tsx scripts/testFixedPriceMigration.ts",
    "test:promotions": "node --import tsx scripts/testPromotionsAndBanners.ts",
    "test:supplier-purchases": "node --import tsx scripts/testSupplierPurchases.ts",
    "test:accounting-periods": "node --import tsx scripts/testAccountingPeriods.ts",
    "test:supplier-invoice-import": "node --import tsx scripts/testSupplierInvoiceImport.ts",
    "test:supplier-invoice-pdf": "node --import tsx scripts/testSupplierInvoicePdfExtraction.ts",
    "test:customer-invoices": "node --import tsx scripts/testCustomerInvoices.ts",
    "test:product-references": "node --import tsx scripts/testProductReferences.ts",
    "test:product-reference-migration": "node --import tsx scripts/testProductReferenceMigration.ts",
    "test:admin-product-images-deletion": "node --import tsx scripts/testAdminProductImagesDeletion.ts",
    "test:admin-products-responsive": "node --import tsx scripts/testAdminProductsResponsive.ts",
    "test:admin-archives": "node --import tsx scripts/testAdminArchives.ts",
    "test:admin-analytics": "node --import tsx scripts/testAdminAnalytics.ts",
    "test:firebase-auth-actions": "node --import tsx scripts/testFirebaseAuthActions.ts",
    "test:order-reliability": "node --import tsx scripts/testOrderReliability.ts",
    "test:payment-link-reliability": "node --import tsx scripts/testPaymentLinkReliability.ts",
    "test:order-cancellation-consistency": "node --import tsx scripts/testOrderCancellationConsistency.ts",
    "test:public-rate-limits": "node --import tsx scripts/testPublicRateLimits.ts",
    "test:api-import": "node --import tsx scripts/testInvoicesApiImport.ts",
    "prerender": "node --import tsx scripts/prerender.ts",
    "sitemap": "node --import tsx scripts/generateSitemap.ts",
    "typecheck:api": "tsc --noEmit --moduleResolution NodeNext --module NodeNext --target ES2022 --esModuleInterop --skipLibCheck --strict --types node api/create-review.ts api/create-order.ts api/quote-order.ts api/admin-payment-links.ts api/send-payment-link.ts api/update-order-status.ts api/retry-order-emails.ts api/revoke-order-analytics.ts api/contact.ts api/invoices.ts api/analyze-supplier-invoice.ts api/_server/adminAuth.ts api/_server/adminPaymentLinks.ts api/_server/checkout.ts api/_server/email.ts api/_server/firebaseAdmin.ts api/_server/ga4MeasurementProtocol.ts api/_server/ga4DataApi.ts api/_server/purchaseAnalytics.ts api/_server/orderSideEffects.ts api/_server/paymentLinkDelivery.ts api/_server/productReferences.ts api/_server/productDeletion.ts api/_server/http.ts api/_server/invoicePdf.ts api/_server/orderAlerts.ts api/_server/supplierInvoiceAnalysis.ts",
    "seed:products": "node --import tsx scripts/seedFirestoreProducts.ts",
    "seed:delivery-zones": "node --import tsx scripts/seedFirestoreDeliveryZones.ts",
    "upsert:aix-radius-zone": "node --import tsx scripts/upsertAixRadiusDeliveryZone.ts",
    "seed:supplier-purchases": "node --import tsx scripts/seedSupplierPurchases.ts",
    "backfill:product-references": "node --import tsx scripts/backfillProductReferences.ts",
    "seed:admin": "node --import tsx scripts/bootstrapAdmin.ts",
    "seed:admin-auth": "node --import tsx scripts/bootstrapAdminAuth.ts",
    "repair:launch-promo-banner": "node --import tsx scripts/repairLaunchPromoBanner.ts",
    "repair:welcome10-promo-banner": "node --import tsx scripts/repairWelcome10PromoBanner.ts",
    "migrate:fixed-price-formats:dry-run": "node --import tsx scripts/migrateFixedPriceFormats.ts",
    "migrate:fixed-price-formats:apply": "node --import tsx scripts/migrateFixedPriceFormats.ts --apply --confirm=verdanza-fixed-price-v1",
    "migrate:product-references-v2:dry-run": "node --import tsx scripts/migrateProductReferencesV2.ts",
    "migrate:product-references-v2:apply": "node --import tsx scripts/migrateProductReferencesV2.ts --apply --confirm=verdanza-product-references-v2",
    "cleanup:test-data": "node --import tsx scripts/cleanupProductionTestData.ts",
    "cleanup:orders": "node --import tsx scripts/cleanupCancelledFinishedOrders.ts",
    "reconcile:launch-stock": "node --import tsx scripts/reconcileLaunchStock.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "firebase-admin": "^14.0.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright": "^1.61.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
