rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminByUid() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true;
    }

    function adminByEmail() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.token.email)).data.isActive == true;
    }

    function isAdmin() {
      return adminByUid() || adminByEmail();
    }

    match /products/{productId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAdmin() || (signedIn() && customerId == request.auth.uid);
      allow create: if signedIn()
        && customerId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "customer";
      allow update: if signedIn()
        && customerId == request.auth.uid
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == "customer"
        && request.resource.data.loyaltyPoints == resource.data.loyaltyPoints
        && request.resource.data.orderCount == resource.data.orderCount
        && request.resource.data.totalSpent == resource.data.totalSpent;
      allow delete: if isAdmin();
    }

    match /stockMovements/{movementId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /loyaltyMovements/{movementId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /promoBanners/{bannerId} {
      allow read: if isAdmin()
        || (resource.data.isActive == true
          && resource.data.isArchived == false);
      allow create, update, delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /adminUsers/{adminUserId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /supplierProducts/{supplierProductId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /labReports/{labReportId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /favorites/{favoriteId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && favoriteId == request.auth.uid + "_" + request.resource.data.productId
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.productCategory is string
        && request.resource.data.productImage is string;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if false;
    }

    match /productReviews/{reviewId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.comment == resource.data.comment
        && request.resource.data.publicVisible == false;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
